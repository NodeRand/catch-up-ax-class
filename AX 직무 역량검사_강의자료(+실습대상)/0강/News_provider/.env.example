# 복사해서 .env 로 저장하고 값을 채우세요. (.env 는 git 에 올리지 마세요)

# --- Gemini API ---
GEMINI_API_KEY=

# --- Gmail SMTP (앱 비밀번호 사용) ---
# Gmail > 보안 > 2단계 인증 > 앱 비밀번호 에서 발급
EMAIL_USER=your_account@gmail.com
EMAIL_APP_PASSWORD=
# 받는 사람 (쉼표로 여러 명)
EMAIL_TO=

# --- Reddit (선택) ---
# 있으면 점수(upvote) 포함 정밀 수집, 없으면 RSS 폴백.
# https://www.reddit.com/prefs/apps 에서 "script" 앱 생성 후 발급
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
